# Copy this file to .env beside docker-compose.yml.
# Preserve existing JWT/database/mail values when adopting this configuration.

# GHCR: lowercase personal account or organization, and the tag used by the images.
GHCR_NAMESPACE=gabriellourenco1912
IMAGE_TAG=latest

# Published ports on the Docker host; internal ports are SERVER_PORT and WEB_PORT.
BACKEND_PUBLISHED_PORT=8080
WEB_PUBLISHED_PORT=3000
WEB_PORT=3000
WEB_HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
# Origem pública do painel no navegador; independente da porta interna WEB_PORT.
# Em produção, use a URL HTTPS pública. Sem caminho, query ou fragmento.
WEB_ORIGIN=http://localhost:3000
# Origem da API acessível pelo contêiner web, sem /api no final.
# Vazio usa http://backend:<SERVER_PORT>; não use localhost para outro contêiner.
WMS_API_BASE_URL=

# Application
SPRING_APPLICATION_NAME=wms-saas
SPRING_THREADS_VIRTUAL_ENABLED=true

# Database
# Leave DB_URL empty to assemble the JDBC URL from DB_HOST, DB_PORT and DB_NAME.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=wms_saas
DB_URL=
DB_USERNAME=root
# Required for the MySQL container; set a real password in .env.
DB_PASSWORD=

# Daily MySQL backup at 02:15 in the host timezone (logs and filenames use UTC).
# See docker/mysql-backup/README.md. Retention must be at least 30 days.
MYSQL_BACKUP_HOST=mysql
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_HOST_DIR=/var/backups/wms/mysql
MYSQL_BACKUP_RETENTION_DAYS=30
# Empty credentials reuse DB_USERNAME/DB_PASSWORD. A read-only account is supported.
MYSQL_BACKUP_USERNAME=
MYSQL_BACKUP_PASSWORD=
# Empty restore settings reuse the backup connection/credentials.
# Restore requires an existing empty database different from DB_NAME.
MYSQL_RESTORE_HOST=
MYSQL_RESTORE_PORT=
MYSQL_RESTORE_USERNAME=
MYSQL_RESTORE_PASSWORD=

# JPA and schema migration
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# SMTP (timeouts in milliseconds)
# Defina um servidor acessível pelo contêiner; localhost aponta para ele próprio.
# O Compose não inclui um servidor SMTP. O login depende do envio de e-mail.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_CONNECTION_TIMEOUT=5000
MAIL_READ_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# Email templates
FREEMARKER_TEMPLATE_LOADER_PATH=classpath:/templates/
FREEMARKER_SUFFIX=.ftlh
FREEMARKER_CHARSET=UTF-8
FREEMARKER_CHECK_TEMPLATE_LOCATION=true

# HTTP
SPRING_MVC_PROBLEMDETAILS_ENABLED=false
SERVER_PORT=8080

# Authentication
MAIL_FROM=no-reply@wms.local
# Required: generate at least 32 random bytes, e.g. openssl rand -hex 32.
JWT_SECRET=
JWT_ISSUER=https://api.wmssaas.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_SECURE=true
# Para desenvolvimento local por HTTP, use REFRESH_COOKIE_SECURE=false.
# Em HTTPS, mantenha true.

# Single-use codes and account locking
AUTH_CHALLENGE_TTL=10m
AUTH_CHALLENGE_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=15m
ACCOUNT_LOCK_UNLOCK_INTERVAL=60000
ACCOUNT_LOCK_SCHEDULER_ENABLED=true

# First manager (only enable for explicit provisioning)
WMS_BOOTSTRAP_ENABLED=false
WMS_BOOTSTRAP_NAME="Gestor inicial"
WMS_BOOTSTRAP_EMAIL=
WMS_BOOTSTRAP_PASSWORD=
